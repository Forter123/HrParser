DATABASE_URL=postgresql+psycopg2://hrparser:hrparser@localhost:5432/hrparser
SECRET_KEY=change-me-to-a-random-secret
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_PATH=./telegram_session
SUPERJOB_CLIENT_ID=your_superjob_app_id
SUPERJOB_CLIENT_SECRET=your_superjob_secret_key
SUPERJOB_LOGIN=employer_account_email
SUPERJOB_PASSWORD=employer_account_password
LINKEDIN_EMAIL=your_linkedin_account_email
LINKEDIN_PASSWORD=your_linkedin_account_password
# HH.ru: register an app at https://dev.hh.ru/admin to get CLIENT_ID/SECRET,
# then complete the OAuth authorization_code flow once (as an employer account
# with resume-database access) to obtain the initial access/refresh token pair.
HH_CLIENT_ID=your_hh_app_client_id
HH_CLIENT_SECRET=your_hh_app_client_secret
HH_ACCESS_TOKEN=initial_access_token
HH_REFRESH_TOKEN=initial_refresh_token
HH_USER_AGENT=HrParser/1.0
# Abuse-prevention for the hh.ru account: pause between per-search requests
# within one poll cycle, and a cap on how many active searches get polled per
# cycle (the rest wait for the next one). Lower values are safer for the
# account but slow down how fast new candidates show up. Keep search keywords
# specific (e.g. "senior python django" not just "python") — that also directly
# reduces how much gets fetched per cycle, no config knob needed for that part.
HH_REQUEST_DELAY_SECONDS=1.0
HH_MAX_SEARCHES_PER_CYCLE=10
# SuperJob browser-automation scraper (app/sources/superjob_scraper_source.py):
# a fallback for when the paid official API isn't affordable. Drives a
# dedicated profile in the Vision antidetect browser (https://browser.vision)
# against SuperJob's public resume search pages instead of using
# api.superjob.ru. Activates purely by having VISION_PROFILE_ID set below (no
# separate on/off flag, same as every other source) — read the module
# docstring before filling this in, it covers real ToS and 152-FZ (personal
# data law) risk, not just "might break if the site changes".
# Requires the Vision app installed and running on this machine, with a
# profile created in it specifically for this purpose (not your personal
# browsing profile) — get folder_id/profile_id from the Vision app or its API
# (see docs.browser.vision -> API -> "Получение списка профилей").
VISION_API_HOST=127.0.0.1
VISION_API_PORT=3030
VISION_API_TOKEN=your_vision_api_token
VISION_FOLDER_ID=your_vision_folder_id
VISION_PROFILE_ID=your_dedicated_superjob_profile_id
# If SuperJob shows a captcha, the Vision browser window is visible for you to
# solve it by hand — this is how long (seconds) the scraper waits for that
# before giving up on the current search for this poll cycle.
SUPERJOB_CAPTCHA_WAIT_SECONDS=180
# hh.ru free fallback (app/sources/hh_scraper_source.py): same idea as the
# SuperJob scraper above, but against hh.ru's public resume search — instead
# of the paid HH_* OAuth setup above. Uses its OWN dedicated Vision profile
# (separate from the SuperJob one), on the same Vision app/API
# (VISION_API_HOST/PORT/TOKEN above are shared). Read the module docstring
# before filling this in — same ToS/152-FZ caveats as the SuperJob scraper.
HH_VISION_FOLDER_ID=your_hh_vision_folder_id
HH_VISION_PROFILE_ID=your_dedicated_hh_profile_id
HH_SCRAPER_CAPTCHA_WAIT_SECONDS=180
POLL_INTERVAL_SECONDS=60
DEDUP_SIMILARITY_THRESHOLD=85
